# Copie este arquivo para .env.local e preencha a chave do Gemini.
# Sem nenhuma chave o app roda em MODO OFFLINE (só regras locais; não lê print).
# NUNCA mande a chave por chat nem suba o .env.local para o GitHub.

# Gemini: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chaves extras (opcional). A cota gratuita é por PROJETO do Google: crie cada chave num projeto diferente
# ("Create API key in new project"), senão elas dividem a mesma cota. Vai até GEMINI_API_KEY_10.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Modelo principal. Se ele falhar, o app tenta sozinho os modelos reserva (ver lib/ia.ts).
GEMINI_MODEL=gemini-3.6-flash

# Opcional: Claude como segundo provedor (reserva se o Gemini cair). https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional: força o provedor principal ("gemini", "claude" ou "offline").
# Com a chave do Gemini no plano gratuito, use "claude": as respostas vêm do Claude
# e a cota do Gemini fica só para transcrever o microfone do estande (o Claude não recebe áudio).
IA_PROVEDOR=

# Proteção da cota (valores padrão já são bons para a feira)
LIMITE_POR_MINUTO=120
LIMITE_IA_DIA=3000

# Voz da Vó Zilda (ElevenLabs). Sem isso a Vó usa a voz do navegador.
# Chave: https://elevenlabs.io > Developers > API Keys (permissão só de Text to Speech).
ELEVENLABS_API_KEY=
# ID da voz criada no Voice Design (não é segredo).
ELEVENLABS_VOICE_ID=
# Modelo das falas novas (rápido e gasta metade do crédito) e das falas fixas gravadas (melhor qualidade).
ELEVENLABS_MODELO=eleven_flash_v2_5
ELEVENLABS_MODELO_GRAVACAO=eleven_multilingual_v2
# Contas extras (opcional), cada uma com a voz criada NELA. Quando a conta 1 para (sem crédito, bloqueada),
# a 2 assume, e assim por diante. Vai até _10. Sem ELEVENLABS_VOICE_ID_N, a conta N tenta a voz da conta 1.
ELEVENLABS_API_KEY_2=
ELEVENLABS_VOICE_ID_2=
# Teto de caracteres por dia em CADA conta (20.000 caracteres ≈ 10.000 créditos no modelo rápido).
LIMITE_VOZ_CARACTERES_DIA=20000

# Modo estande (fila, ligação única, TV e placares). Veja PUBLICAR.md, seção 7.
# Senha do painel /admin (invente uma e não divulgue).
ESTANDE_SENHA=
# Banco Redis (Upstash). Na Vercel estas duas variáveis são criadas sozinhas quando você conecta o banco ao projeto
# (podem aparecer como KV_REST_API_URL e KV_REST_API_TOKEN, o app aceita os dois nomes).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
